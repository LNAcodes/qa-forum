{%extends "_base.njk"%} {% block title %}Ask a Question - Q&A Forum{% endblock
%} {% block content %} <a href="/">Back to Home</a>
<form action="/questions/{{question.id}}/edit" method="POST" class="form-example">
  <div>
    <label for="title">Title</label>
    <input type="text" name="title" id="title" value="{{question.title}}" required />
  </div>
  <div>
    <label for="body">Body</label>
    <textarea name="body" id="body" required>{{question.body}}</textarea>
  </div>
  <input type="submit" value="Edit Question" />
</form>
{% endblock %}
